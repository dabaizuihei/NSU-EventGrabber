# 可选高级配置。复制为 config.env 后使用，日常设置建议直接在 GUI 里改。
# GUI 保存的 settings.json 优先级高于这个文件。

# 平台地址，一般不用改
NSU_BASE_URL=https://study.nsu.edu.cn
# 租户信息，留空时启动后自动获取
NSU_TENANT_ID=
NSU_TENANT_NAME=
# 登录窗口自动填充的学号/工号，可留空
NSU_USERNAME=

# 通知渠道，可选 desktop / webhook
NOTIFY_PROVIDERS=desktop
# Webhook 地址与类型，类型可留 auto 自动识别
WEBHOOK_URL=
WEBHOOK_KIND=auto

# 扫描间隔，单位秒，最小 30
SCAN_INTERVAL_SECONDS=300
# 请求超时，单位秒
REQUEST_TIMEOUT=20
# 自动报名
AUTO_REGISTER=true
# 报名屏蔽词，命中后仍提醒但不自动报名
REGISTER_BLOCKLIST=仅限.*报名|工作人员|参赛人员
# 关键词白名单，留空表示不限制
KEYWORD_INCLUDE=
# 关键词黑名单，命中后不显示、不提醒、不报名
KEYWORD_EXCLUDE=
# 即将参加提醒提前天数
UPCOMING_DAYS=3
# 单页拉取数量
PAGE_SIZE=50

# 登录态失效时自动重登
AUTO_RELOGIN=true
# 打开软件并登录后自动开始监控（默认开启）
AUTO_MONITOR=true
# 关闭主窗口时隐藏到系统托盘，监控继续运行
CLOSE_TO_TRAY=true
# 启动后检查 GitHub Release 是否有新版本
AUTO_CHECK_UPDATE=true
# 已报名列表隐藏过期活动
HIDE_PAST_REGISTERED=true
